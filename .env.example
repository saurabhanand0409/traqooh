# TraqOOH Environment Variables — COPY THIS TO .env AND FILL IN VALUES
# Never commit .env to git

# ── Backend (backend-python/.env) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/traqooh_db

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=traqooh-uploads
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ── Frontend (frontend/.env.production) ───────────────────────────────────────
VITE_API_BASE=https://traqooh-backend-python.onrender.com
VITE_FRONTEND_URL=https://traqooh.brandsculpt.com
