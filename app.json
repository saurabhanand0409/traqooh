{
  "expo": {
    "name": "TraqOOH",
    "slug": "traqooh-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TraqOOH uses your location to show nearby billboard sites."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070C1A",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "com.brandsculpt.traqooh"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TraqOOH uses your location to show nearby billboard sites."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TraqOOH needs photo access to attach site activity photos.",
          "cameraPermission": "TraqOOH needs camera access to take site activity photos."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f41cf806-a1de-4667-8a6c-07f9c68153ea"
      }
    }
  }
}
